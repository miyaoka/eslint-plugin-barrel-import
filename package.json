{
  "name": "@miyaoka/eslint-plugin-barrel-import",
  "version": "0.0.0",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/miyaoka/eslint-plugin-barrel-import.git"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsgo --project tsconfig.build.json",
    "fix": "knip --fix",
    "knip": "knip",
    "typecheck": "tsgo --noEmit",
    "test": "bun test",
    "prepublishOnly": "pnpm build",
    "release": "bumpp"
  },
  "devDependencies": {
    "@types/bun": "1.4.2",
    "@types/node": "24.13.4",
    "@typescript-eslint/parser": "8.70.0",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "bumpp": "12.3.0",
    "eslint": "10.9.1",
    "knip": "6.35.0",
    "lefthook": "2.1.12"
  },
  "peerDependencies": {
    "eslint": ">=9"
  }
}
