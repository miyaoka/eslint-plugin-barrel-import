{
  "name": "@miyaoka/eslint-plugin-barrel-import",
  "version": "0.0.0",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/miyaoka/eslint-plugin-barrel-import.git"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsgo --project tsconfig.build.json",
    "fix": "knip --fix",
    "knip": "knip",
    "typecheck": "tsgo --noEmit",
    "test": "bun test",
    "prepublishOnly": "pnpm build",
    "release": "bumpp"
  },
  "devDependencies": {
    "@types/bun": "1.3.14",
    "@types/node": "24.12.4",
    "@typescript-eslint/parser": "8.59.4",
    "@typescript/native-preview": "7.0.0-dev.20260521.1",
    "bumpp": "11.1.0",
    "eslint": "10.4.0",
    "knip": "6.14.1",
    "lefthook": "2.1.8"
  },
  "peerDependencies": {
    "eslint": ">=9"
  }
}
